# Supabase project URL — Supabase dashboard → Project Settings → API → Project URL
# Safe to expose to the browser (public). Leave BOTH Supabase vars blank to
# run in local-only mode (localStorage; no sync, no account).
#
# Remote sync requires signing in with EMAIL (magic link). Configure the
# email provider + Site URL + Redirect URLs in the Supabase dashboard — see
# PERSISTENCE_QA.md. Anonymous sign-ins are NOT used and should stay disabled.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — Supabase dashboard → Project Settings → API → anon public key
# Safe to expose to the browser (public). Row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key — https://console.anthropic.com/settings/keys
# SERVER-ONLY. Never exposed to the browser; used only by app/api/ai.
# If blank, the AI route returns deterministic mock output.
ANTHROPIC_API_KEY=

# Optional: Anthropic model id used by the AI route (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# Optional: closed-beta feedback destination (LIFEOS-048). PUBLIC.
# A mailto:, form URL, or issues link shown as "Send feedback" on the Help page.
# If blank, Help shows a calm "reply to your invitation" fallback (no broken link).
NEXT_PUBLIC_FEEDBACK_URL=

# --- Optional embedding provider (LIFEOS-015 semantic retrieval) ---
# ALL SERVER-ONLY (never prefix with NEXT_PUBLIC_). Used only by app/api/embed.
# If unset, a built-in local lexical embedder is used and deterministic search
# is unaffected. LifeOS does NOT assume Anthropic provides embeddings.
# EMBEDDING_PROVIDER_URL — any OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# --- Stripe subscriptions (LIFEOS-BILLING) ---
# SERVER-ONLY. Never prefix either of these with NEXT_PUBLIC_: `lib/billing`
# reads them behind `import "server-only"`, so a client import is a BUILD error,
# and `npm run audit:billing` fails if that marker is ever removed.
# Leave blank to run without billing — checkout, the portal and the webhook all
# report themselves unavailable, and the access gate stands down.
#
# Stripe dashboard → Developers → API keys (use the TEST key first).
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks → your endpoint → signing secret.
# Must match the endpoint the events are actually sent to; a mismatch makes
# every delivery fail signature verification, which is the intended behaviour.
STRIPE_WEBHOOK_SECRET=

# Conqify's two recurring prices. NOT secrets, but kept server-side so the
# browser sends a plan word ("monthly" / "annual") and never a price id.
# The sandbox values are documented in BILLING.md; promotion to live mode is
# replacing these four variables and nothing else.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Absolute origin used to build Stripe return URLs, e.g. https://app.conqify.com
# Optional: when blank, each request's own origin is used, which is what makes
# preview deployments work without per-branch configuration.
APP_URL=

# Whether this deployment requires a paid subscription. PUBLIC and not a secret
# — it is a statement about the deployment, read by the access gate in the
# browser. Anything other than "true" leaves the gate off, which is the default
# so that deploying billing does not paywall an existing beta on the same day.
NEXT_PUBLIC_REQUIRE_PAID_ACCESS=
